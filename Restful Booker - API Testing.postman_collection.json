        {
          "name": "Booking by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nif (pm.response.code === 200) {\r\n    const response = pm.response.json();\r\n\r\n    pm.test(\"Booking data is correct\", function () {\r\n        pm.expect(response.firstname).to.eql(\"papas\");\r\n        pm.expect(response.lastname).to.eql(\"fritas\");\r\n        pm.expect(response.totalprice).to.eql(150000);\r\n        pm.expect(response.depositpaid).to.eql(true);\r\n    });\r\n\r\n    pm.test(\"Booking dates are correct\", function () {\r\n        pm.expect(response.bookingdates.checkin).to.eql(\"2026-10-15\");\r\n        pm.expect(response.bookingdates.checkout).to.eql(\"2026-10-20\");\r\n    });\r\n\r\n    pm.test(\"Additional needs is Breakfast\", function () {\r\n        pm.expect(response.additionalneeds).to.eql(\"Breakfast\");\r\n    });\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nif (pm.response.code === 200) {\r\n    const response = pm.response.json();\r\n\r\n    pm.test(\"Booking data was updated\", function () {\r\n        pm.expect(response.firstname).to.eql(\"papas\");\r\n        pm.expect(response.lastname).to.eql(\"fritas\");\r\n        pm.expect(response.totalprice).to.eql(200000);\r\n        pm.expect(response.depositpaid).to.eql(false);\r\n    });\r\n\r\n    pm.test(\"Booking dates were updated\", function () {\r\n        pm.expect(response.bookingdates.checkin).to.eql(\"2026-11-01\");\r\n        pm.expect(response.bookingdates.checkout).to.eql(\"2026-11-10\");\r\n    });\r\n\r\n    pm.test(\"Additional needs was updated\", function () {\r\n        pm.expect(response.additionalneeds).to.eql(\"Dinner\");\r\n    });\r\n}"
                ]
              }
            }
          ],
