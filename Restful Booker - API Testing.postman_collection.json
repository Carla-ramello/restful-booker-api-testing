          "name": "Get All Booking IDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Response body is an array\", function () {\r\n    const response = pm.response.json();\r\n    pm.expect(response).to.be.an(\"array\");\r\n});\r\n\r\npm.test(\"Each booking has a numeric bookingid\", function () {\r\n    const response = pm.response.json();\r\n\r\n    response.forEach(function (booking) {\r\n        pm.expect(booking).to.have.property(\"bookingid\");\r\n        pm.expect(booking.bookingid).to.be.a(\"number\");\r\n    });\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
